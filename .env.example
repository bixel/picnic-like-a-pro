# Picnic credentials
PICNIC_USERNAME=your@email.com
PICNIC_PASSWORD=yourpassword
PICNIC_COUNTRY_CODE=NL        # NL, DE, or BE
# If Picnic asks for a 2FA code, log in once with /picnic_login in Telegram or
# `uv run python scripts/picnic_login.py`; the session is stored in the DB.
# PICNIC_LOGIN_USER_IDS=123456789   # who may run /picnic_login and /picnic_code (default: every allowed user)

# Mock mode — replaces the Picnic API with an in-process fake. No credentials
# are used and no real order or checkout can ever be triggered.
# Leave unset/false in production. See .env.mock.example for the demo setup.
# PICNIC_MOCK=true
# PICNIC_MOCK_PERSIST_CART=true   # keep the mock cart across restarts

# Telegram
TELEGRAM_BOT_TOKEN=123456:ABC-...

# LLM — every model request goes through OpenRouter (https://openrouter.ai).
OPENROUTER_API_KEY=sk-or-v1-...
# Default model for every chat that has not pinned its own. Any OpenRouter
# model id works: see https://openrouter.ai/models (copy the id, e.g.
# "openai/gpt-5" or "google/gemini-2.5-pro"). Per-chat overrides live in the
# DB — manage them with `uv run python scripts/chat_model.py`.
LLM_MODEL=anthropic/claude-sonnet-4.6
# LLM_MAX_TOKENS=4096               # output cap per request (default: 4096)
# LLM_ALLOWED_MODELS=               # comma-separated; if set, per-chat models must be in it
# OPENROUTER_APP_NAME=Picnic Like a Pro   # shown on your OpenRouter activity page
# OPENROUTER_APP_URL=               # optional HTTP-Referer for OpenRouter attribution
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1   # change only for a proxy/gateway

# App config
DB_PATH=data/picnic.db
ALLOWED_TELEGRAM_USER_IDS=123456789,987654321   # comma-separated; leave empty to deny all
# ALLOW_ALL_USERS=true                          # uncomment only for local dev (allows everyone)

# Conversation history
# Conversations are stored in the SQLite DB and survive restarts. The full
# transcript is kept; only the window sent to the API is capped. Each chat can
# opt out with /privacy off, and /forget deletes a chat's stored history.
MAX_HISTORY_TURNS=20          # messages sent to the API per chat = 2 x this (default: 20)
PERSIST_CONVERSATIONS=true    # global kill-switch; false = in-memory only, nothing written

# API request log (api_requests table)
# Every Picnic and OpenRouter request is logged with its URL, headers (credentials
# masked) and full bodies. Chats that opted out of history (/privacy off) get
# metadata only, and /forget deletes a chat's rows. Treat the DB as sensitive.
# API_LOG_BODIES=true           # false = no bodies at all (URLs and headers still stored)
# API_LOG_RETENTION_DAYS=30     # import_history.py prunes older rows; 0 = keep everything

# Reporting UI (`uv run web`)
# Log in with a one-time link from the bot's /report command.
# WEB_HOST=127.0.0.1                    # leave on localhost unless a reverse proxy with TLS sits in front
# WEB_PORT=8080
# WEB_BASE_URL=http://localhost:8080    # what /report links point at (http://localhost:5173 with `npm run dev`)
# WEB_SESSION_SECRET=                   # signs the session cookie; unset = sessions end when the web app restarts

# MCP server (when run standalone)
MCP_TRANSPORT=stdio           # stdio | sse | http
MCP_HOST=127.0.0.1
MCP_PORT=8000

# Import / repair tuning (both scripts read these)
IMPORT_BATCH_SIZE=10          # deliveries/orders/products fetched per batch (default: 10)
IMPORT_DELAY_SECONDS=2        # pause between batches to avoid rate limits (default: 2)
IMPORT_BACKOFF_SECONDS=60     # first wait after Picnic rate limits (429/HTML 403); doubles (default: 60)
IMPORT_BACKOFF_RETRIES=4      # retries after a rate limit before the run stops (default: 4)
CATEGORY_REFRESH_DAYS=30      # refresh category names older than this; 0 = never (default: 30)
CATEGORY_RETRY_DAYS=7         # retry a name lookup that found nothing after this (default: 7)
CATEGORY_REFRESH_LIMIT=20     # L2 pages refreshed per import run (default: 20)

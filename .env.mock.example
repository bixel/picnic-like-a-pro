# Mock environment — persistent demo/playground instance.
#
# Uses the in-process Picnic mock: no real Picnic credentials required and no
# real checkout can ever be triggered. Cart and database persist across
# restarts in their own Docker volume, separate from production.
#
# Template only. On the host: `cp .env.mock.example .env.mock` and fill in the
# real tokens. .env.mock is gitignored so those tokens never get committed.

# Picnic — unused while PICNIC_MOCK=true, kept for config-shape parity
PICNIC_USERNAME=mock@example.com
PICNIC_PASSWORD=mock_password
PICNIC_COUNTRY_CODE=NL

# Mock mode
PICNIC_MOCK=true
PICNIC_MOCK_PERSIST_CART=true

# Telegram — MUST be a different bot token than production
TELEGRAM_BOT_TOKEN=REPLACE_WITH_MOCK_BOT_TOKEN

# Anthropic — the mock bot still talks to the real Claude API
ANTHROPIC_API_KEY=REPLACE_WITH_API_KEY

# Database — separate file inside the mock volume
DB_PATH=data/picnic-mock.db

# Access control — restrict to testers, or open up for a demo
ALLOWED_TELEGRAM_USER_IDS=
# ALLOW_ALL_USERS=true

MAX_HISTORY_TURNS=20

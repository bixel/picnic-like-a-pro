{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/bixel/picnic-like-a-pro/main/calm/controls/integrity.requirement.json",
  "title": "Integrity control requirement",
  "description": "An invariant the code maintains, and how it fails when it cannot.",
  "type": "object",
  "allOf": [
    {
      "$ref": "https://calm.finos.org/release/1.2/meta/control-requirement.json"
    }
  ],
  "properties": {
    "control-id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "documented-in": {
      "type": "string",
      "description": "Where the rule is written down"
    },
    "enforced-in": {
      "type": "string",
      "description": "Code location that enforces the control"
    },
    "env": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Environment variables that configure it"
    },
    "failure-mode": {
      "type": "string"
    }
  },
  "required": [
    "control-id",
    "name",
    "description",
    "documented-in",
    "enforced-in",
    "failure-mode"
  ]
}

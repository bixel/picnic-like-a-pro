# Test environment — ephemeral, fully automated, safe to wipe at any time.
#
# Contains no real secrets: the Picnic API is mocked and neither Telegram nor
# the Anthropic API are contacted by the test suite. Safe to commit.

# Picnic — mocked
PICNIC_USERNAME=test@example.com
PICNIC_PASSWORD=test_password
PICNIC_COUNTRY_CODE=NL

# Mock mode — cart is in-memory only so every test run starts clean
PICNIC_MOCK=true
PICNIC_MOCK_PERSIST_CART=false

# Placeholder credentials — tests never make outbound calls with these
ANTHROPIC_API_KEY=sk-ant-test-key-not-real
TELEGRAM_BOT_TOKEN=0000000000:test-token-not-real

# Database — wiped by `make wipe-test` / `docker compose down -v`
DB_PATH=data/picnic-test.db

ALLOW_ALL_USERS=true
MAX_HISTORY_TURNS=20
# Conversations persist to the test DB, which `make wipe-test` clears.
PERSIST_CONVERSATIONS=true
